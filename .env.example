# 闲鱼 MCP 配置示例文件
# 复制此文件为 .env 并修改配置

# ========== 浏览器配置 ==========
# 是否无头模式（true/false）
XIANYU_HEADLESS=false

# 浏览器路径（留空使用默认）
# XIANYU_BROWSER_PATH=

# 视口大小
XIANYU_VIEWPORT_WIDTH=1920
XIANYU_VIEWPORT_HEIGHT=1080

# ========== Cookie 配置 ==========
# Cookie 文件路径
XIANYU_COOKIE_FILE=./cookies/default.json

# 用户数据目录
XIANYU_USER_DATA_DIR=./user_data

# ========== 日志配置 ==========
# 日志级别 (DEBUG/INFO/WARNING/ERROR)
XIANYU_LOG_LEVEL=INFO

# 日志文件路径
XIANYU_LOG_FILE=./logs/xianyu.log

# ========== 超时配置 ==========
# 操作超时时间（秒）
XIANYU_TIMEOUT=30

# 页面加载超时（秒）
XIANYU_PAGE_LOAD_TIMEOUT=60

# ========== 频率控制（秒） ==========
# 搜索间隔
XIANYU_SEARCH_INTERVAL=3.0

# 发布间隔
XIANYU_PUBLISH_INTERVAL=30.0

# 消息间隔
XIANYU_MESSAGE_INTERVAL=5.0

# ========== 闲鱼配置 ==========
# 闲鱼网页版 URL
XIANYU_XIANYU_URL=https://www.goofish.com/

# 闲鱼手机版 URL
XIANYU_XIANYU_MOBILE_URL=https://m.goofish.com/
